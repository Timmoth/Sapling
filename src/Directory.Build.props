<Project>
  <!-- Shared release identity for the CLI, engine package and supporting projects. -->
  <PropertyGroup>
    <Version>2.1.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>2.1.0</AssemblyVersion>
    <FileVersion>2.1.0</FileVersion>
  </PropertyGroup>
  <!-- Append build symbols without preventing project-specific constants from being added.
       Separate multiple symbols with %3B on the command line. -->
  <PropertyGroup Condition="'$(SaplingBuildConstants)' != ''">
    <DefineConstants>$(DefineConstants);$(SaplingBuildConstants)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
