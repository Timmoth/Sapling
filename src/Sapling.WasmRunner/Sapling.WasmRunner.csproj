<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmEnableSIMD Condition="'$(WasmNoSIMD)' == 'true'">false</WasmEnableSIMD>
  </PropertyGroup>

  <!-- Compiles the shared test sources and drives them without vstest, which has no
       browser-wasm test host. xunit Assert throws on failure, so a reflection driver
       over [Fact]/[Theory]+[InlineData] is sufficient for lane qualification. -->
  <ItemGroup>
    <Compile Include="../Sapling.Engine.Tests/**/*.cs" Exclude="../Sapling.Engine.Tests/bin/**;../Sapling.Engine.Tests/obj/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sapling.Engine\Sapling.Engine.csproj" />
  </ItemGroup>

</Project>
